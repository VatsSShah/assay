# Source distribution contents. The sdist must carry everything needed to run the benchmark and
# reproduce the shipped artifacts, not just the importable modules.
include LICENSE NOTICE README.md SPEC.md TASKS.md COVERAGE.md CONTRIBUTING.md
include CHANGELOG.md SECURITY.md REMAINING_GAPS.md IMPLEMENTATION_SUMMARY.md
include REPRODUCIBILITY.md Dockerfile
include tasks.json manifest_schema.json twins.json
include coverage.py
recursive-include src/assay_bench/data *.json
recursive-include leaderboard *.json *.md *.py
recursive-include reference *.json
recursive-include tests *.py *.json
recursive-include audit *.md *.json *.py
recursive-include demo *.sh *.py *.md *.html *.mjs
recursive-include corpus *.md
# The evidence-format, witness, replication and methodology documentation, and the example
# experiment configs and replication template, are part of how a reader checks a result, so they
# travel with the source rather than living only on the forge.
recursive-include docs *.md
recursive-include research *.md *.py
recursive-include case-studies *.md
recursive-include experiments *.md *.json *.jsonl
recursive-include scripts *.sh
# The registry record and the attestation are published EVIDENCE, not just
# documentation: a reader of the sdist should be able to see the worked example
# rather than take its description on trust. The git ordering behind it cannot
# travel, so the test that reads history skips outside a checkout.
recursive-include precommit *.md *.json
recursive-include attest *.md *.json
prune demo/out
prune demo/recording/frames
global-exclude *.pyc __pycache__ *.webm *.mp4
